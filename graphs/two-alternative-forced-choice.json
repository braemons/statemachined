{
  "name": "two-alternative-forced-choice",
  "entry": "Ready",

  "distributions": {
    "foreperiod": { "kind": "exponential", "minimum_ms": 500, "maximum_ms": 2500, "mean_ms": 900 },
    "hold_before_cue": { "kind": "uniform", "minimum_ms": 300, "maximum_ms": 700 },
    "response_window": { "kind": "fixed", "duration_ms": 1500 }
  },

  "states": [
    {
      "name": "Ready",
      "on_entry": [{ "line": "ready_lamp", "kind": "high" }],
      "transitions": [
        {
          "when": { "all": ["start_switch"], "none": ["abort", "lever_left", "lever_right"] },
          "goto": "Foreperiod"
        }
      ]
    },

    {
      "name": "Foreperiod",
      "timeout": { "after": "foreperiod", "goto": "Cue" },
      "transitions": [
        { "when": { "any": ["lever_left", "lever_right"] }, "goto": "Early" },
        { "when": { "all": ["abort"] }, "goto": "Aborted" }
      ]
    },

    {
      "name": "Cue",
      "on_entry": [{ "line": "cue_lamp", "kind": "high" }],
      "timeout": { "after": "response_window", "goto": "Late" },
      "transitions": [
        {
          "when": { "all": ["lever_left"], "none": ["lever_right"] },
          "hold": "hold_before_cue",
          "goto": "ChoseLeft"
        },
        {
          "when": { "all": ["lever_right"], "none": ["lever_left"] },
          "hold": "hold_before_cue",
          "goto": "ChoseRight"
        },
        { "when": { "all": ["abort"] }, "goto": "Aborted" }
      ]
    },

    {
      "name": "ChoseLeft",
      "outcome": "HIT",
      "on_entry": [
        { "line": "reward_valve", "kind": "pulse", "pulse_ms": 40 },
        { "line": "ready_lamp", "kind": "high" }
      ]
    },
    {
      "name": "ChoseRight",
      "outcome": "WRONG_RESPONSE",
      "on_entry": [{ "line": "error_lamp", "kind": "high" }]
    },
    { "name": "Early", "outcome": "EARLY" },
    { "name": "Late", "outcome": "LATE" },
    { "name": "Aborted", "outcome": "CANCELLED" }
  ]
}
