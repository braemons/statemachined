{
  "name": "go-nogo",
  "entry": "Ready",

  "distributions": {
    "foreperiod": { "kind": "exponential", "minimum_ms": 500, "maximum_ms": 2500, "mean_ms": 900 },
    "response_window": { "kind": "fixed", "duration_ms": 1000 },
    "outcome_lamp_hold": { "kind": "fixed", "duration_ms": 400 },
    "inter_trial_interval": { "kind": "uniform", "minimum_ms": 1500, "maximum_ms": 3000 }
  },

  "states": [
    {
      "name": "Ready",
      "on_entry": [{ "line": "ready_lamp", "kind": "high" }],
      "transitions": [
        {
          "when": { "all": ["start_switch"], "none": ["abort"] },
          "goto": "Foreperiod"
        }
      ]
    },

    {
      "name": "Foreperiod",
      "timeout": { "after": "foreperiod", "goto": "Cue" },
      "transitions": [
        { "when": { "any": ["lever"] }, "goto": "Early" },
        { "when": { "all": ["abort"] }, "goto": "Aborted" }
      ]
    },

    {
      "name": "Cue",
      "on_entry": [{ "line": "cue_lamp", "kind": "high" }],
      "timeout": { "after": "response_window", "goto": "Late" },
      "transitions": [
        { "when": { "all": ["lever"] }, "goto": "Hit" },
        { "when": { "all": ["abort"] }, "goto": "Aborted" }
      ]
    },

    {
      "name": "Hit",
      "outcome": "HIT",
      "relight_after": "inter_trial_interval",
      "on_entry": [
        { "line": "reward_valve", "kind": "pulse", "pulse_ms": 40 },
        { "line": "ready_lamp", "kind": "high" }
      ]
    },
    { "name": "Early", "outcome": "EARLY", "relight_after": "inter_trial_interval" },
    { "name": "Late", "outcome": "LATE", "relight_after": "inter_trial_interval" },
    { "name": "Aborted", "outcome": "CANCELLED" }
  ]
}
