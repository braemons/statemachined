# The trace is the NDJSON tail of every state visit, appended a file per day.
# The daemon never reads it back -- it is the copy for the analysis that happens
# months later -- and dev/DAEMON.md is explicit that it is nobody's to keep.
# A recording is the opposite: somebody's experiment, kept until they delete it,
# which is why /var/lib/braemons/statemachined/recordings is not named here.
#
# `nocreate` and no postrotate signal on purpose: the writer opens the file for
# append per batch and closes it, so there is no descriptor to point at a
# rotated-away inode and nothing to HUP.
/var/lib/braemons/statemachined/trace/trace-*.ndjson {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    nocreate
    su statemachined statemachined
}
