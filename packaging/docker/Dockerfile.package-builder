# Build the package inside the OS it targets, so the artifact is a function of
# this file rather than of whoever's laptop ran it.
#
# vstimd's Dockerfile.deb-builder is the model, with one difference: this image
# is run *as* the target architecture rather than cross-compiling, so the arm64
# package is built under qemu:
#
#   docker build --platform linux/arm64 ...
#
# Slower than a cross-compile and much simpler: one recipe, packaging/Makefile's
# `packages-here`, builds both architectures, and the check at its end runs the
# binary it is about to pack.
#
# One image produces both formats. nfpm packs a .deb and a .rpm from the same
# staged tree, so the matrix here is by architecture alone.
#
# Usage -- via `make -C packaging packages-amd64` / `packages-arm64`, which pass
# the version and the timestamp the host computed:
#
#   docker build --platform linux/amd64 \
#     -f packaging/docker/Dockerfile.package-builder \
#     --build-arg STATEMACHINED_VERSION=0.1.0 -t statemachined-package-builder-amd64 .
#   docker run --rm -v $(pwd)/dist:/output statemachined-package-builder-amd64

# Pinned by digest, not by tag. `bookworm-slim` names a moving target, and a
# builder image that drifts is a build that is reproducible only until somebody
# pushes to Docker Hub. Bookworm because that is what Raspberry Pi OS 12 is, so
# the glibc the daemon links against is the one the Pi 5 has.
ARG BASE_IMAGE=debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
FROM ${BASE_IMAGE}

ARG NFPM_VERSION=2.43.1
# The compiler, pinned: a different rustc is a different binary.
ARG RUST_VERSION=1.98.0

ENV DEBIAN_FRONTEND=noninteractive

# Everything the build needs and nothing else. gcc for the linker; curl for
# rustup and for the check that fetches the staged daemon's panels.
RUN apt-get update && apt-get install -y --no-install-recommends \
        make git curl ca-certificates xz-utils file gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal --default-toolchain ${RUST_VERSION} \
    && rustc --version

# nfpm's release assets say x86_64 but arm64, which is neither uname's spelling
# nor dpkg's consistently -- hence the map rather than a substitution.
RUN set -eux; \
    case "$(uname -m)" in \
      x86_64)  nfpm_arch=x86_64 ;; \
      aarch64) nfpm_arch=arm64  ;; \
      *) echo "no nfpm build for $(uname -m)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/nfpm.tar.gz \
      "https://github.com/goreleaser/nfpm/releases/download/v${NFPM_VERSION}/nfpm_${NFPM_VERSION}_Linux_${nfpm_arch}.tar.gz"; \
    tar xzf /tmp/nfpm.tar.gz -C /usr/local/bin nfpm; \
    rm -f /tmp/nfpm.tar.gz; \
    nfpm --version

WORKDIR /src

# What the package is built from, and nothing else, so an unrelated edit does
# not invalidate the layers below.
COPY Makefile README.md LICENSE NOTICE ./
COPY Cargo.toml Cargo.lock ./
COPY daemon/            daemon/
COPY client/web/           client/web/
COPY docs/                 docs/
COPY dev/                  dev/
COPY packaging/            packaging/

# Built by `make image` on the host, or an empty directory the Makefile made so
# this COPY has something to copy. packaging/Makefile says which.
COPY image/ image/

ARG STATEMACHINED_VERSION
ENV STATEMACHINED_VERSION=${STATEMACHINED_VERSION}

ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

RUN make -C packaging packages-here \
    && mkdir -p /out \
    && find dist -maxdepth 1 \( -name '*.deb' -o -name '*.rpm' \) -exec cp {} /out/ \;

CMD ["sh", "-c", "cp /out/* /output/ && ls -lh /output/"]
