# renode-test writes its Robot report and, on a failure, the Renode log and a
# snapshot of the emulated machine, into the directory it was run from.
robot_output.xml
log.html
report.html
/logs/
/snapshots/

# Editor swap files. One of these got committed by a careless `git add -A`.
*.swp
*.swo
*~


# `image/` is where the image target stages what CI uploads; running it by
# hand must not dirty the tree.
/image/

# The native device's settings store -- its data flash, as a file. Written in
# the working directory by `make bench-device` unless STATEMACHINED_STORE names
# somewhere else; the tests give each device one under their own tmp_path.
/statemachined-store.bin
